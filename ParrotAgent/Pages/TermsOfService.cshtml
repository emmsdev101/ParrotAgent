@page "/Terms"
@model ParrotAgent.Pages.TermsOfServiceModel;
@{
    ViewData["Title"] = "Terms of Service";
    Layout = "_Layout";  // explicit — uses Pages/Shared/_Layout.cshtml
}

@section Styles {
    <link rel="stylesheet" href="~/css/terms.css" asp-append-version="true" />
}

<!-- ============ Page header ============ -->
<div class="terms-page">
<header class="terms-header">
    <div class="terms-header-inner">
        <span class="terms-badge">
            <i class="fas fa-shield-halved"></i> Legal
        </span>
