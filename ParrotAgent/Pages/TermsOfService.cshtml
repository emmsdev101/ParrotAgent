            <span class="terms-meta-item">
                <i class="far fa-calendar"></i> Last updated: <strong>January 15, 2025</strong>
            </span>
            <span class="terms-meta-item">
                <i class="fas fa-code-branch"></i> Version: <strong>2.1</strong>
            </span>
            <span class="terms-meta-item">
                <i class="far fa-clock"></i> Reading time: <strong>~8 min</strong>
            </span>
        </div>
    </div>
</header>

