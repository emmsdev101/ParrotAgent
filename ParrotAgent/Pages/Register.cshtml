@page "/register"
@model ParrotAgent.Pages.RegisterModel
@* Views/Account/Register.cshtml *@
@{
    ViewData["Title"] = "Create your account";
}

<section class="auth-section">
    <div class="pa-container">
        <div class="auth-wrapper">

            <!-- Left: Marketing / value panel -->
            <aside class="auth-aside">
                <div class="auth-aside-inner">
                    @* <span class="auth-aside-badge">
                        <i class="fas fa-sparkles"></i> Free forever · No credit card
                    </span> *@
                    <h2>Start building your knowledge base today.</h2>
                    <p>
                        Join thousands of teams who organize, share, and discover
                        knowledge with ParrotAgent.
                    </p>

                    <ul class="auth-features">
                        <li>
                            <span class="auth-feature-icon"><i class="fas fa-folder-plus"></i></span>
                            <div>
                                <strong>Unlimited knowledge bases</strong>
                                <small>Organize knowledge by team, project, or topic.</small>
                            </div>
                        </li>
                        <li>
                            <span class="auth-feature-icon purple"><i class="fas fa-cloud-upload-alt"></i></span>
                            <div>
                                <strong>Bulk document upload</strong>
                                <small>PDFs, DOCX, TXT and 20+ formats supported.</small>
                            </div>
                        </li>
                        <li>
                            <span class="auth-feature-icon green"><i class="fas fa-search"></i></span>
                            <div>
                                <strong>Instant AI search</strong>
                                <small>Semantic search across all your documents.</small>
                            </div>
                        </li>
                    </ul>

                    <div class="auth-aside-footer">
                        <div class="auth-avatars">
                            <span>J</span>
                            <span>M</span>
                            <span>A</span>
                            <span>R</span>
                        </div>
                        <p><strong>2,400+</strong> teams onboarded this month</p>
                    </div>
                </div>
            </aside>

            <!-- Right: Form -->
            <form method="post" class="auth-form">
                    @Html.AntiForgeryToken()
            <div class="auth-card">
                <header class="auth-header">
                    <h1>Create your account</h1>
                    <p>Get started in under 30 seconds.</p>
                </header>

                

                    <!-- Firstname -->
                    <div class="auth-field">
                        <label for="FirstName">First name</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-user"></i>
                            <input type="text" asp-for="UserFormData.FirstName"
                                   placeholder="Jane Cooper" autocomplete="name" required />
                        </div>
                        <span asp-validation-for="UserFormData.FirstName" class="text-danger"></span>
                    </div>

                    <!-- Lastname -->
                    <div class="auth-field">
                        <label for="LastName">Last name</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-user"></i>
                            <input type="text" asp-for="UserFormData.LastName"
                                   placeholder="Jane Cooper" autocomplete="family-name" required />
                        </div>
                        <span asp-validation-for="UserFormData.LastName" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="auth-field">
                        <label for="UserFormData.Email">Work email</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-envelope"></i>
                            <input type="email" asp-for="UserFormData.Email"
                                   placeholder="you@company.com" autocomplete="email" required />
                        </div>
                        <span asp-validation-for="UserFormData.Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="auth-field">
                        <label asp-for="UserFormData.Password">Password</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-lock"></i>
                            <input type="password" asp-for="UserFormData.Password"
                                   placeholder="At least 8 characters"
                                   autocomplete="new-password"
                                   required
                                   minlength="8"
                                   maxlength="128"
                                   pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,128}"
                                   title="Use 8–128 characters with at least one letter and one number." />
                            <button type="button" class="auth-toggle-pass" data-pa-toggle-password aria-label="Show password">
                                <i class="far fa-eye"></i>
                            </button>
                        </div>
                        <div class="auth-hint" id="password-strength" data-level="empty" aria-live="polite">
                            <span class="auth-hint-bar"><i></i></span>
                            <span class="auth-hint-text">Use 8+ characters with a mix of letters & numbers.</span>
                        </div>
                        <ul class="auth-password-rules" id="password-rules">
                            <li data-rule="length"><i class="fas fa-circle" aria-hidden="true"></i> At least 8 characters</li>
                            <li data-rule="letter"><i class="fas fa-circle" aria-hidden="true"></i> At least one letter</li>
                            <li data-rule="number"><i class="fas fa-circle" aria-hidden="true"></i> At least one number</li>
                        </ul>
                        <span asp-validation-for="UserFormData.Password" class="text-danger"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="auth-field">
                        <label asp-for="UserFormData.ConfirmPassword">Confirm password</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-lock"></i>
                            <input type="password" asp-for="UserFormData.ConfirmPassword"
                                   placeholder="Re-enter your password"
                                   autocomplete="new-password" required />
                            <button type="button" class="auth-toggle-pass" data-pa-toggle-password aria-label="Show password">
                                <i class="far fa-eye"></i>
                            </button>
                        </div>
                        <div class="auth-hint" id="confirm-password-hint" data-level="empty" aria-live="polite">
                            <span class="auth-hint-text">Re-enter the same password.</span>
                        </div>
                        <span asp-validation-for="UserFormData.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <!-- Terms -->
                    <label class="auth-check">
                        <input type="checkbox" name="AcceptTerms" required />
                        <span class="auth-check-box"><i class="fas fa-check"></i></span>
                        <span class="auth-check-text">
                            I agree to the <a href="/Terms">Terms of Service</a> and <a href="/Privacy">Privacy Policy</a>.
                        </span>
                    </label>

                    <!-- Submit -->
                    <button type="submit" class="pa-btn pa-btn-primary auth-submit">
                        Create account <i class="fas fa-arrow-right"></i>
                    </button>


                <footer class="auth-footer">
                    Already have an account?
                    <a href="/login">Sign in</a>
                </footer>
            </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {

<partial name="_ValidationScriptsPartial" />
    <script>
        // Password visibility toggle
        document.querySelectorAll('[data-pa-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                var icon = btn.querySelector('i');
                var isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.classList.toggle('fa-eye', !isPassword);
                icon.classList.toggle('fa-eye-slash', isPassword);
                btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
            });
        });

        // Live password rules, strength, and confirmation match
        (function () {
            var password = document.getElementById('UserFormData_Password');
            var confirmPassword = document.getElementById('UserFormData_ConfirmPassword');
            var strength = document.getElementById('password-strength');
            var rules = document.getElementById('password-rules');
            var confirmHint = document.getElementById('confirm-password-hint');
            if (!password || !confirmPassword || !strength || !rules || !confirmHint) return;

            var strengthText = strength.querySelector('.auth-hint-text');
            var confirmText = confirmHint.querySelector('.auth-hint-text');
            var requirementMessage = 'Use 8–128 characters with at least one letter and one number.';

            function checksFor(value) {
                return {
                    length: value.length >= 8 && value.length <= 128,
                    letter: /[A-Za-z]/.test(value),
                    number: /[0-9]/.test(value),
                    upper: /[A-Z]/.test(value),
                    lower: /[a-z]/.test(value),
                    symbol: /[^A-Za-z0-9]/.test(value)
                };
            }

            function updateConfirm() {
                var confirmValue = confirmPassword.value;
                if (!confirmValue) {
                    confirmPassword.setCustomValidity('');
                    confirmHint.setAttribute('data-level', 'empty');
                    confirmText.textContent = 'Re-enter the same password.';
                    return;
                }

                if (confirmValue === password.value) {
                    confirmPassword.setCustomValidity('');
                    confirmHint.setAttribute('data-level', 'strong');
                    confirmText.textContent = 'Passwords match.';
                    return;
                }

                confirmPassword.setCustomValidity('Passwords do not match.');
                confirmHint.setAttribute('data-level', 'weak');
                confirmText.textContent = 'Passwords do not match.';
            }

            function updatePassword() {
                var value = password.value;
                var checks = checksFor(value);
                var requiredMet = checks.length && checks.letter && checks.number;

                rules.querySelectorAll('[data-rule]').forEach(function (item) {
                    var rule = item.getAttribute('data-rule');
                    var met = !!checks[rule];
                    var started = value.length > 0;
                    item.classList.toggle('is-met', started && met);
                    item.classList.toggle('is-unmet', started && !met);
                    var icon = item.querySelector('i');
                    if (icon) icon.className = started && met ? 'fas fa-check' : 'fas fa-circle';
                });

                if (!value) {
                    password.setCustomValidity('');
                    strength.setAttribute('data-level', 'empty');
                    strengthText.textContent = 'Use 8+ characters with a mix of letters & numbers.';
                } else if (!requiredMet) {
                    password.setCustomValidity(requirementMessage);
                    strength.setAttribute('data-level', 'weak');
                    strengthText.textContent = requirementMessage;
                } else if (checks.upper && checks.lower && checks.symbol) {
                    password.setCustomValidity('');
                    strength.setAttribute('data-level', 'strong');
                    strengthText.textContent = 'Strong password.';
                } else {
                    password.setCustomValidity('');
                    strength.setAttribute('data-level', 'fair');
                    strengthText.textContent = 'Meets requirements. Add mixed case and a symbol to make it stronger.';
                }

                updateConfirm();
            }

            password.addEventListener('input', updatePassword);
            confirmPassword.addEventListener('input', updateConfirm);
        })();
    </script>
}