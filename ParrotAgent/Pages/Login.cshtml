
@page "/login"
@model ParrotAgent.Pages.LoginModel
@* Views/Account/Login.cshtml *@
@{
    ViewData["Title"] = "Log in to your account";
}

<section class="auth-section">
    <div class="pa-container">
        <div class="auth-wrapper">

            <!-- Left: Marketing / value panel -->
            <aside class="auth-aside">
                <div class="auth-aside-inner">
                    <span class="auth-aside-badge">
                        <i class="fas fa-sparkles"></i> Free forever · No credit card
                    </span>
                    <h2>Start building your knowledge base today.</h2>
                    <p>
                        Join thousands of teams who organize, share, and discover
                        knowledge with ParrotAgent.
                    </p>

                    <ul class="auth-features">
                        <li>
                            <span class="auth-feature-icon"><i class="fas fa-folder-plus"></i></span>
                            <div>
                                <strong>Unlimited knowledge bases</strong>
                                <small>Organize knowledge by team, project, or topic.</small>
                            </div>
                        </li>
                        <li>
                            <span class="auth-feature-icon purple"><i class="fas fa-cloud-upload-alt"></i></span>
                            <div>
                                <strong>Bulk document upload</strong>
                                <small>PDFs, DOCX, TXT and 20+ formats supported.</small>
                            </div>
                        </li>
                        <li>
                            <span class="auth-feature-icon green"><i class="fas fa-search"></i></span>
                            <div>
                                <strong>Instant AI search</strong>
                                <small>Semantic search across all your documents.</small>
                            </div>
                        </li>
                    </ul>

                    <div class="auth-aside-footer">
                        <div class="auth-avatars">
                            <span>J</span>
                            <span>M</span>
                            <span>A</span>
                            <span>R</span>
                        </div>
                        <p><strong>2,400+</strong> teams onboarded this month</p>
                    </div>
                </div>
            </aside>

            <!-- Right: Form -->
            <div class="auth-card">
                <header class="auth-header">
                    <h1>Create your account</h1>
                    <p>Get started in under 30 seconds.</p>
                </header>

                <form method="post" class="auth-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger"></div>

                    <!-- Email -->
                    <div class="auth-field">
                        <label for="Email">Work email</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-envelope"></i>
                            <input type="email" asp-for="LoginUser.Email"
                                   placeholder="you@company.com" autocomplete="email" required />
                        </div>
                        <span asp-validation-for="LoginUser.Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="auth-field">
                        <label for="Password">Password</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-lock"></i>
                            <input type="password" asp-for="LoginUser.Password"
                                   placeholder="At least 8 characters"
                                   autocomplete="new-password" required minlength="8" />
                            <button type="button" class="auth-toggle-pass" data-pa-toggle-password aria-label="Show password">
                                <i class="far fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="LoginUser.Password" class="text-danger"></span>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="pa-btn pa-btn-primary auth-submit">
                        Log In <i class="fas fa-arrow-right"></i>
                    </button>

                    <!-- Divider -->
                    <div class="auth-divider"><span>or continue with</span></div>

                    <!-- Social -->
                    <div class="auth-social">
                        <button type="button" class="auth-social-btn">
                            <i class="fab fa-google"></i> Google
                        </button>
                        <button type="button" class="auth-social-btn">
                            <i class="fab fa-github"></i> GitHub
                        </button>
                    </div>
                </form>

                <footer class="auth-footer">
                    Don't havean account?
                    <a href="/register">Sign up</a>
                </footer>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Password visibility toggle
        document.querySelectorAll('[data-pa-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                var icon = btn.querySelector('i');
                var isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.classList.toggle('fa-eye', !isPassword);
                icon.classList.toggle('fa-eye-slash', isPassword);
            });
        });
    </script>
}